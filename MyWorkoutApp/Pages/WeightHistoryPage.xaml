<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyWorkoutApp.Pages.WeightHistoryPage"
             Title="היסטוריית שקילות"
             BackgroundColor="#0d0d1a"
             FlowDirection="RightToLeft"
             NavigationPage.HasBackButton="False">

    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0">
            <BoxView HeightRequest="120" Color="#111130" VerticalOptions="Fill" />
            <Grid ColumnDefinitions="*, Auto" Padding="20,36,16,18" VerticalOptions="Fill">
                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                    <Label Text="היסטוריית שקילות" FontSize="22" FontAttributes="Bold" TextColor="White" />
                    <Label Text="כל השקילות שלך מיום 1" FontSize="13" TextColor="#6666aa" />
                </VerticalStackLayout>

                <Button Grid.Column="1" Text="✕ חזור" Clicked="OnBackClicked"
                        BackgroundColor="Transparent" TextColor="#ff5555" BorderColor="#ff555544" BorderWidth="1"
                        FontAttributes="Bold" FontSize="13" CornerRadius="10" Padding="12,0" HeightRequest="36" VerticalOptions="Center" />
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="AllWeightsContainer" Spacing="8" Padding="16" />
        </ScrollView>
    </Grid>
</ContentPage>