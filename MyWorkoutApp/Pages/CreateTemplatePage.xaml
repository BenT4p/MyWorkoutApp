<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyWorkoutApp.Pages.CreateTemplatePage"
             Title="תבנית אימון חדשה"
             BackgroundColor="#0d0d1a"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">

        <!-- ══════════════════════════════════ HERO HEADER ══════════════════════════════════ -->
        <Grid Grid.Row="0">
            <BoxView HeightRequest="180"
                     Color="#111130"
                     VerticalOptions="Fill" />

            <!-- Accent glow -->
            <Ellipse Fill="#3322ff"
                     Opacity="0.12"
                     WidthRequest="200"
                     HeightRequest="200"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,-60,-70,0" />

            <Grid ColumnDefinitions="*, Auto"
                  Padding="20,36,16,16"
                  VerticalOptions="Fill">

                <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                    <Label Text="תכנית אימון חדשה 📋"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White"
                           CharacterSpacing="-0.5" />
                    <Label Text="הגדר שם ובחר תרגילים"
                           FontSize="13"
                           TextColor="#6666aa" />
                </VerticalStackLayout>

                <!-- Back button -->
                <Button Grid.Column="1"
                        Text="✕ חזור"
                        Clicked="OnBackClicked"
                        BackgroundColor="Transparent"
                        TextColor="#ff5555"
                        BorderColor="#ff555544"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="10"
                        Padding="12,0"
                        HeightRequest="36"
                        VerticalOptions="Center" />
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════ TEMPLATE NAME ENTRY ══════════════════════════════════ -->
        <Frame Grid.Row="1"
               BackgroundColor="#161630"
               BorderColor="#2a2a55"
               CornerRadius="14"
               Padding="16,12"
               Margin="16,12,16,0"
               HasShadow="False">
            <VerticalStackLayout Spacing="6">
                <Label Text="שם התכנית"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#6666aa"
                       CharacterSpacing="0.5" />
                <Entry x:Name="TemplateNameEntry"
                       Placeholder="לדוגמה: כוח עליון, רגליים, גב..."
                       PlaceholderColor="#44447a"
                       TextColor="White"
                       BackgroundColor="Transparent"
                       FontSize="16"
                       FontAttributes="Bold" />
            </VerticalStackLayout>
        </Frame>

        <!-- ══════════════════════════════════ ADD EXERCISE BUTTON ══════════════════════════════════ -->
        <Button Grid.Row="2"
                Text="＋ הוסף תרגיל"
                Clicked="OnAddExerciseClicked"
                BackgroundColor="Transparent"
                TextColor="#3322ff"
                FontAttributes="Bold"
                FontSize="14"
                CornerRadius="12"
                Padding="0,11"
                BorderColor="#3322ff44"
                BorderWidth="1"
                Margin="16,10,16,0" />

        <!-- ══════════════════════════════════ SELECTED EXERCISES LIST ══════════════════════════════════ -->
        <CollectionView Grid.Row="3"
                        x:Name="SelectedExercisesList"
                        Margin="0,8,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="16,5"
                           Padding="14,12"
                           CornerRadius="18"
                           BackgroundColor="#161630"
                           HasShadow="False"
                           BorderColor="#2a2a55">
                        <Grid ColumnDefinitions="*, 90, Auto" ColumnSpacing="8">

                            <VerticalStackLayout Grid.Column="0"
                                                 VerticalOptions="Center"
                                                 Spacing="3">
                                <Label Text="{Binding Name}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding MuscleGroup}"
                                       FontSize="12"
                                       TextColor="#6666aa" />
                            </VerticalStackLayout>

                            <Frame Grid.Column="1"
                                   Padding="0"
                                   CornerRadius="10"
                                   Margin="0,2"
                                   IsClippedToBounds="True"
                                   BackgroundColor="#0d0d1a"
                                   BorderColor="#2a2a55">
                                <Image Source="{Binding ImagePath}" Aspect="AspectFit">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnImageZoomClicked" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </Frame>

                            <Button Grid.Column="2"
                                    Text="✕"
                                    FontSize="16"
                                    BackgroundColor="Transparent"
                                    TextColor="#ff5555"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    Padding="0"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnRemoveExerciseClicked"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ══════════════════════════════════ SAVE BUTTON ══════════════════════════════════ -->
        <Button Grid.Row="4"
                x:Name="SaveButton"
                Text="💾  שמור תכנית"
                Clicked="OnSaveTemplateClicked"
                BackgroundColor="#3322ff"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="16"
                CornerRadius="14"
                Padding="0,14"
                Margin="16,8,16,16"
                IsEnabled="False" />

        <!-- ══════════════════════════════════ ZOOM OVERLAY ══════════════════════════════════ -->
        <Grid x:Name="ZoomOverlay"
              IsVisible="False"
              BackgroundColor="#CC000000"
              Grid.RowSpan="5">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseZoomClicked" />
            </Grid.GestureRecognizers>
            <Frame BackgroundColor="#161630"
                   BorderColor="#2a2a55"
                   CornerRadius="20"
                   Padding="12"
                   Margin="30"
                   VerticalOptions="Center"
                   HorizontalOptions="Center">
                <Image x:Name="ZoomImage"
                       Aspect="AspectFit"
                       MaximumHeightRequest="400" />
            </Frame>
        </Grid>

    </Grid>
</ContentPage>
