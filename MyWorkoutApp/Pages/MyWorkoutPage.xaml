<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyWorkoutApp.Pages.MyWorkoutsPage"
             Title="האימונים שלי"
             BackgroundColor="#0d0d1a"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, Auto, *">

        <Grid Grid.Row="0">
            <BoxView HeightRequest="180"
                     Color="#111130"
                     VerticalOptions="Fill" />

            <Image Source="logo.png"
                   WidthRequest="60"
                   HeightRequest="60"
                   HorizontalOptions="End" 
                   VerticalOptions="Start"
                   Margin="0,36,20,0" />

            <Ellipse Fill="#3322ff"
                     Opacity="0.12"
                     WidthRequest="220"
                     HeightRequest="220"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,-60,-80,0" />

            <VerticalStackLayout Padding="20,36,20,20" Spacing="4">
                <Label Text="האימונים שלי"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="White"
                       CharacterSpacing="-0.5" />
                <Label Text="תוכניות והיסטוריית אימונים"
                       FontSize="15"
                       TextColor="#6666aa" />
            </VerticalStackLayout>
        </Grid>

        <Frame Grid.Row="1"
               BackgroundColor="#0d0d1a"
               BorderColor="#2a2a55"
               CornerRadius="14"
               Padding="4"
               Margin="16,10,16,4"
               HasShadow="False">
            <Grid ColumnDefinitions="*,*">
                <Button x:Name="TemplatesTabBtn"
                        Grid.Column="0"
                        Text="תוכניות האימון שלי"
                        Clicked="OnTemplatesTabClicked"
                        BackgroundColor="#3322ff"
                        TextColor="White"
                        FontSize="13"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        Padding="0"
                        HeightRequest="38" />

                <Button x:Name="HistoryTabBtn"
                        Grid.Column="1"
                        Text="היסטוריית האימונים"
                        Clicked="OnHistoryTabClicked"
                        BackgroundColor="Transparent"
                        TextColor="#6666aa"
                        FontSize="13"
                        CornerRadius="10"
                        Padding="0"
                        HeightRequest="38" />
            </Grid>
        </Frame>

        <Grid x:Name="TemplatesTab" Grid.Row="2" RowDefinitions="Auto,*">

            <Button Grid.Row="0"
                    Text="＋ צור תוכנית אימון חדשה"
                    Clicked="OnCreateTemplateClicked"
                    BackgroundColor="#3322ff"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="15"
                    CornerRadius="14"
                    Padding="0,13"
                    Margin="16,10,16,4"
                    HorizontalOptions="Fill" />

            <VerticalStackLayout x:Name="TemplatesEmpty"
                                 Grid.Row="1"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="10"
                                 IsVisible="False">
                <Label Text="📋" FontSize="56" HorizontalOptions="Center" />
                <Label Text="אין תוכניות אימון"
                       FontSize="18"
                       TextColor="#aaaacc"
                       HorizontalOptions="Center" />
                <Label Text="צור תוכנית חדשה כדי להתחיל"
                       FontSize="14"
                       TextColor="#6666aa"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <CollectionView Grid.Row="1"
                            x:Name="TemplatesList"
                            Margin="0,4,0,8">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="16,5"
                               Padding="16,14"
                               CornerRadius="18"
                               BackgroundColor="#161630"
                               HasShadow="False"
                               BorderColor="#2a2a55">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}"
                                                      Tapped="OnTemplateFrameTapped" />
                            </Frame.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">

                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="1"
                                            Text="🗑"
                                            FontSize="17"
                                            BackgroundColor="Transparent"
                                            TextColor="#ff5555"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            Padding="0"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnDeleteTemplateClicked" />
                                </Grid>

                                <Label Grid.Row="1"
                                       Text="{Binding ExerciseSummary}"
                                       FontSize="13"
                                       TextColor="#6666aa" />

                                <Button Grid.Row="2"
                                        Text="▶  התחל אימון"
                                        BackgroundColor="Transparent"
                                        TextColor="#3322ff"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        CornerRadius="10"
                                        Padding="0,10"
                                        BorderColor="#3322ff44"
                                        BorderWidth="1"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnStartWorkoutClicked" />

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid x:Name="HistoryTab" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,*">

            <Button Grid.Row="0"
                    Text="מחק הכל 🗑️"
                    Clicked="OnClearHistoryClicked"
                    BackgroundColor="Transparent"
                    TextColor="#ff5555"
                    BorderColor="#ff555544"
                    BorderWidth="1"
                    CornerRadius="10"
                    HeightRequest="36"
                    Padding="14,0"
                    FontSize="12"
                    FontAttributes="Bold"
                    HorizontalOptions="End"
                    Margin="16,10,16,0" />

            <VerticalStackLayout x:Name="HistoryEmpty"
                                 Grid.Row="1"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="10"
                                 IsVisible="True">
                <Label Text="🏋️" FontSize="56" HorizontalOptions="Center" />
                <Label Text="אין עדיין היסטוריית אימונים"
                       FontSize="18"
                       TextColor="#aaaacc"
                       HorizontalOptions="Center" />
                <Label Text="סיים אימון כדי שיופיע כאן"
                       FontSize="14"
                       TextColor="#6666aa"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <CollectionView x:Name="HistoryList"
                            Grid.Row="1"
                            IsVisible="False"
                            Margin="0,4,0,8">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="16,5"
                               Padding="16,14"
                               CornerRadius="18"
                               BackgroundColor="#161630"
                               HasShadow="False"
                               BorderColor="#2a2a55">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}"
                                                      Tapped="OnHistorySessionTapped" />
                            </Frame.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">

                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="1"
                                            Text="🗑"
                                            FontSize="17"
                                            BackgroundColor="Transparent"
                                            TextColor="#ff5555"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            Padding="0"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnDeleteSessionClicked" />
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding DateDisplay}"
                                           FontSize="12"
                                           TextColor="#6666aa" />

                                    <Frame Grid.Column="1"
                                           BackgroundColor="#0d0d1a"
                                           BorderColor="#2a2a55"
                                           CornerRadius="8"
                                           Padding="8,3"
                                           HasShadow="False">
                                        <Label Text="{Binding DurationDisplay, StringFormat='⏱ {0}'}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#3322ff" />
                                    </Frame>
                                </Grid>

                                <Label Grid.Row="2"
                                       Text="{Binding ExerciseSummary}"
                                       FontSize="13"
                                       TextColor="#6666aa" />

                                <Button Grid.Row="3"
                                        Text="🔁  חזור על אימון זה"
                                        BackgroundColor="Transparent"
                                        TextColor="#3322ff"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        CornerRadius="10"
                                        Padding="0,10"
                                        BorderColor="#3322ff44"
                                        BorderWidth="1"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnRepeatSessionClicked" />

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

    </Grid>
</ContentPage>